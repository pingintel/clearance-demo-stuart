{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Opus",
      "type": "shell",
      "command": "claude --model claude-opus-4-8",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "tab": "Opus"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Orchestrator",
      "type": "shell",
      "command": "claude --model claude-sonnet-4-6",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-4-6"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "tab": "Orchestrator"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Codex Agent",
      "type": "shell",
      "command": "codex",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "tab": "Codex Agent"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Antigravity Agent",
      "type": "shell",
      "command": "agy",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "tab": "Antigravity Agent"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}